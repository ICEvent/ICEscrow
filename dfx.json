{
  "canisters": {
    "escrow": {
      "main": "backend/main.mo",
      "type": "motoko",
      "args": "--enhanced-orthogonal-persistence",
      "wasm_memory_persistence": "keep"
    },
    "escrow_assets": {
      "dependencies": [
        "escrow"
      ],
      "frontend": {
        "entrypoint": "dist/index.html"
      },
      "source": [
        "dist/"
      ],
      "type": "assets"
    }
  },
  "defaults": {
    "build": {
      "packtool": ""
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:8000",
      "type": "ephemeral"
    },
    "ic": {
      "providers": [
        "https://mainnet.dfinity.network"
      ],
      "type": "persistent"
    }
  },
  "version": 1
}
