[
  {
    "match": "**/*",
    "security_policy": "standard",
    "headers": {
      "Content-Security-Policy": "default-src 'self';script-src 'self';connect-src 'self' http://localhost:* https://ic0.app https://*.ic0.app https://icp0.io https://*.icp0.io https://icp-api.io;img-src 'self' data: blob: https:;style-src * 'unsafe-inline';style-src-elem * 'unsafe-inline';font-src *;object-src 'none';base-uri 'self';frame-ancestors 'none';form-action 'self';upgrade-insecure-requests;"
    },
    "disable_security_policy_warning": true
  },
  {
    "match": ".well-known",
    "ignore": false
  },
  {
    "match": ".well-known/ii-alternative-origins",
    "headers": {
      "Access-Control-Allow-Origin": "*",
      "Content-Type": "application/json"
    },
    "ignore": false
  },
  {
    "match": "**/*",
    "enable_aliasing": true
  }
]
